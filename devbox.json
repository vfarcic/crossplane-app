{
  "packages": [
    "kind@0.32.0",
    "gh@2.98.0",
    "kubectl@1.36.3",
    "yq-go@4.50.1",
    "go-task@3.53.1",
    "kubernetes-helm@4.2.4",
    "kyverno-chainsaw@0.2.15",
    "kcl-cli@0.8.9",
    "vals@0.42.6",
    "git@2.55.0",
    "kubectl-tree@0.6.0",
    "nushell@0.115.1",
    "upbound@0.40.3",
    "azure-cli@2.89.1",
    "crossplane-cli@2.4.1",
    "upcloud-cli@3.29.0",
    "jq@1.8.2",
    "hey@0.1.4",
    "viddy@1.3.1",
    "awscli2@2.35.11"
  ],
  "shell": {
    "init_hook": [
      "export PATH=$PATH:$HOME/.npm-global/bin",
      "[ -n \"$USE_VALS\" ] && eval \"$(vals env -export -f .env.vals.yaml)\" || true",
      "[ -f .env ] && source .env || true"
    ],
    "scripts": {
      "cluster-create":  ["./dot.nu setup"],
      "cluster-destroy": ["./dot.nu destroy"],
      "package-publish": ["task package-publish"],
      "test":            ["./dot.nu setup", "task test-once"],
      "test-watch":      ["task test-watch"]
    }
  }
}
